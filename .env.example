# Copy this file to .env (same folder) and fill in the two values. Never commit .env.
# Both values are public (safe inside the app); they are NOT secrets.

# Your Railway server address, e.g. https://autowish-production-1234.up.railway.app
EXPO_PUBLIC_API_URL=
# Clerk dashboard -> API keys -> Publishable key (starts with pk_)
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=
