<?xml version="1.0" encoding="utf-8"?>
<!--
  Only listens to WhatsApp windows (packageNames), and only to know when the chat
  with the scheduled wish has opened so it can tap Send.
  isAccessibilityTool="false": this is an automation feature, not a tool for people
  with disabilities, so Google Play reviews it under the right policy.
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
  android:accessibilityEventTypes="typeWindowStateChanged|typeWindowContentChanged"
  android:accessibilityFeedbackType="feedbackGeneric"
  android:accessibilityFlags="flagReportViewIds"
  android:canRetrieveWindowContent="true"
  android:notificationTimeout="200"
  android:packageNames="com.whatsapp,com.whatsapp.w4b"
  android:isAccessibilityTool="false"
  android:description="@string/autowish_autosend_description" />
