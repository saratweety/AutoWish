# Copy this file to .env for running the server on your Mac. Never commit .env.
# On Railway, set these in the service's Variables tab instead.

# SECRET. On Railway use: ${{Postgres.DATABASE_URL}}
DATABASE_URL=
# SECRET. Clerk dashboard -> API keys -> Secret key (sk_...)
CLERK_SECRET_KEY=
# Not secret. Clerk dashboard -> API keys -> Publishable key (pk_...)
CLERK_PUBLISHABLE_KEY=
# Railway sets this by itself
PORT=8080

# Photos (milestone B5). Leave empty to run without photo uploads.
#
# On Railway you do NOT paste these values. Add a Bucket, then in the server
# service's Variables tab point each one at the bucket (swap "Bucket" for your
# bucket service's real name), exactly like DATABASE_URL above:
#   S3_ENDPOINT=${{Bucket.ENDPOINT}}
#   S3_REGION=${{Bucket.REGION}}
#   S3_BUCKET=${{Bucket.BUCKET}}
#   S3_ACCESS_KEY_ID=${{Bucket.ACCESS_KEY_ID}}
#   S3_SECRET_ACCESS_KEY=${{Bucket.SECRET_ACCESS_KEY}}
# Railway fills in the real values itself, so the keys never get copied by hand
# and they keep working if the bucket's keys are ever rotated.
#
# Railway's "connect to a service" preset for the AWS SDK also works: the server
# reads the AWS_* and bare BUCKET/ACCESS_KEY_ID names too (see lib/photoStore.ts).
#
# Only fill the lines below in to run the server on your own Mac.
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
# SECRET
S3_ACCESS_KEY_ID=
# SECRET
S3_SECRET_ACCESS_KEY=
# Set to true only if the bucket's Credentials tab says it needs path-style addresses
S3_FORCE_PATH_STYLE=
