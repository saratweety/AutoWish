# Copy this file to .env for running the server on your Mac. Never commit .env.
# On Railway, set these in the service's Variables tab instead.

# SECRET. On Railway use: ${{Postgres.DATABASE_URL}}
DATABASE_URL=
# SECRET. Clerk dashboard -> API keys -> Secret key (sk_...)
CLERK_SECRET_KEY=
# Not secret. Clerk dashboard -> API keys -> Publishable key (pk_...)
CLERK_PUBLISHABLE_KEY=
# Railway sets this by itself
PORT=8080

# Photos (milestone B5). Leave empty to run without photo uploads.
# Railway: + Create -> Bucket, then copy the values from the bucket's Credentials tab.
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
# SECRET
S3_ACCESS_KEY_ID=
# SECRET
S3_SECRET_ACCESS_KEY=
# Set to true only if your bucket needs path-style addresses
S3_FORCE_PATH_STYLE=
